{
  "manifest_version": 2,
  "id": "powdered-delta.maibot-social-link-parser",
  "version": "0.1.5",
  "name": "MaiBot 社媒聚合解析",
  "description": "解析抖音、小红书、小黑盒和可选 B站链接；默认先发送概览，待原发送者确认后下载原媒体。",
  "author": {
    "name": "Powdered-Delta",
    "url": "https://github.com/Powdered-Delta"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Powdered-Delta/maibot-social-link-parser",
    "homepage": "https://github.com/Powdered-Delta/maibot-social-link-parser",
    "issues": "https://github.com/Powdered-Delta/maibot-social-link-parser/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiofiles",
      "version_spec": ">=25.1.0"
    },
    {
      "type": "python_package",
      "name": "msgspec",
      "version_spec": ">=0.21.0"
    },
    {
      "type": "python_package",
      "name": "yt-dlp",
      "version_spec": ">=2026.3.17"
    },
    {
      "type": "python_package",
      "name": "bilibili-api-python",
      "version_spec": ">=17.4.1"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
